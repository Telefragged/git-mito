{
  description = "git-mito: git worktrees as btrfs snapshots of a maintained base";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
      ];
      forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});

      # Cargo.nix is generated by `crate2nix generate`; regenerate it whenever
      # Cargo.lock changes.
      cargoNix =
        pkgs:
        let
          # btrfs-uapi and btrfs-disk generate their ioctl bindings with bindgen.
          bindgen = attrs: {
            nativeBuildInputs = (attrs.nativeBuildInputs or [ ]) ++ [ pkgs.rustPlatform.bindgenHook ];
          };
        in
        pkgs.callPackage ./Cargo.nix {
          defaultCrateOverrides = pkgs.defaultCrateOverrides // {
            btrfs-uapi = bindgen;
            btrfs-disk = bindgen;
          };
        };
    in
    {
      packages = forAllSystems (pkgs: rec {
        git-mito = (cargoNix pkgs).rootCrate.build;
        default = git-mito;
      });

      checks = forAllSystems (pkgs: {
        unit = (cargoNix pkgs).rootCrate.build.override { runTests = true; };
        vm = pkgs.callPackage ./nix/vm-test.nix {
          git-mito = self.packages.${pkgs.stdenv.hostPlatform.system}.git-mito;
        };
      });

      devShells = forAllSystems (pkgs: {
        default = pkgs.mkShell {
          packages = with pkgs; [
            cargo
            rustc
            clippy
            rustfmt
            rust-analyzer
            crate2nix
            btrfs-progs
          ];
          nativeBuildInputs = [ pkgs.rustPlatform.bindgenHook ];
        };
      });
    };
}
