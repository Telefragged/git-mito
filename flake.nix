{
  description = "git-mito: git worktrees as btrfs snapshots of a maintained base";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    let
      systems = [
        "x86_64-linux"
        "aarch64-linux"
      ];
      forAllSystems = f: nixpkgs.lib.genAttrs systems (system: f nixpkgs.legacyPackages.${system});

      # Cargo.nix is generated by `crate2nix generate`; regenerate it whenever
      # Cargo.lock changes. Our own crate (local source, no `sha256`) compiles
      # with clippy-driver under Cargo.toml's `[lints]`; dependencies stay
      # plain rustc.
      cargoNix =
        pkgs:
        let
          lints = (fromTOML (builtins.readFile ./Cargo.toml)).lints;
          # btrfs-uapi and btrfs-disk generate their ioctl bindings with bindgen.
          bindgen = attrs: {
            nativeBuildInputs = (attrs.nativeBuildInputs or [ ]) ++ [ pkgs.rustPlatform.bindgenHook ];
          };
        in
        pkgs.callPackage ./Cargo.nix {
          # Cargo.nix only applies `defaultCrateOverrides` by overriding what
          # this returns, so the overrides live in `base` instead.
          buildRustCrateForPkgs =
            p:
            let
              base = p.buildRustCrate.override {
                defaultCrateOverrides = p.defaultCrateOverrides // {
                  btrfs-uapi = bindgen;
                  btrfs-disk = bindgen;
                };
              };
            in
            crate:
            if crate ? sha256 then
              base crate
            else
              (base crate).override (prev: {
                useClippy = true;
                inherit lints;
                # Workaround for an upstream nixpkgs bug: buildRustCrate sets
                # RUSTC_DRIVER without exporting it, so the `make` subshells
                # that compile binaries fall back to plain rustc and skip
                # clippy. Exported here, before the build phase assigns it,
                # the assignment stays exported.
                preBuild = (prev.preBuild or "") + "\nexport RUSTC_DRIVER\n";
              });
        };
    in
    {
      packages = forAllSystems (pkgs: rec {
        git-mito = (cargoNix pkgs).rootCrate.build;
        default = git-mito;
      });

      checks = forAllSystems (pkgs: {
        unit = (cargoNix pkgs).rootCrate.build.override { runTests = true; };
        vm = pkgs.callPackage ./nix/vm-test.nix {
          git-mito = self.packages.${pkgs.stdenv.hostPlatform.system}.git-mito;
        };
      });

      devShells = forAllSystems (pkgs: {
        default = pkgs.mkShell {
          packages = with pkgs; [
            cargo
            rustc
            clippy
            rustfmt
            rust-analyzer
            crate2nix
            btrfs-progs
          ];
          nativeBuildInputs = [ pkgs.rustPlatform.bindgenHook ];
        };
      });
    };
}
